{
  "description": "Open an isolated worktree from a dirty checkout and review a change made inside it.",
  "fixture": {
    "files": { "README.md": "# QA fixture\n\nbaseline line\n" },
    "dirty": { "README.md": "# QA fixture\n\nuncommitted checkout edit\n" }
  },
  "steps": [
    {
      "tool": "open_workspace",
      "arguments": { "path": "{{fixture}}", "mode": "worktree" }
    },
    {
      "tool": "apply_patch",
      "arguments": {
        "workspace_id": "{{workspace_id}}",
        "patch": "*** Begin Patch\n*** Add File: WORKTREE.md\n+created inside the worktree\n*** End Patch"
      }
    },
    {
      "tool": "show_changes",
      "arguments": { "workspace_id": "{{workspace_id}}" }
    }
  ]
}
