{
  "description": "Claude surface: open a checkout, write and edit files, run bash, and review the changes.",
  "config": { "tools": { "mode": "claude" } },
  "host": { "clientName": "Claude" },
  "fixture": {
    "files": {
      "README.md": "# QA fixture\n\nbaseline line\n",
      "notes/todo.md": "- [ ] first\n- [ ] second\n"
    }
  },
  "steps": [
    {
      "tool": "open_workspace",
      "arguments": { "path": "{{fixture}}" }
    },
    {
      "tool": "edit",
      "arguments": {
        "workspace_id": "{{workspace_id}}",
        "path": "notes/todo.md",
        "edits": [{ "old_text": "- [ ] first", "new_text": "- [x] first" }]
      }
    },
    {
      "tool": "write",
      "arguments": {
        "workspace_id": "{{workspace_id}}",
        "path": "notes/new.md",
        "content": "# New note\n\nWritten during QA.\n"
      }
    },
    {
      "tool": "bash",
      "arguments": { "workspace_id": "{{workspace_id}}", "command": "git status --short" },
      "expect": { "text": ["notes/todo.md", "notes/new.md"] }
    },
    {
      "tool": "show_changes",
      "arguments": { "workspace_id": "{{workspace_id}}" }
    }
  ]
}
