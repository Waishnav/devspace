{
  "description": "No tools config: an OAuth client named ChatGPT gets the Codex surface.",
  "host": {
    "clientName": "ChatGPT"
  },
  "fixture": {
    "files": {
      "README.md": "# QA fixture\n\nbaseline line\n",
      "notes/todo.md": "- [ ] first\n- [ ] second\n"
    }
  },
  "steps": [
    {
      "tool": "open_workspace",
      "arguments": {
        "path": "{{fixture}}"
      }
    },
    {
      "tool": "apply_patch",
      "arguments": {
        "workspace_id": "{{workspace_id}}",
        "patch": "*** Begin Patch\n*** Update File: notes/todo.md\n@@\n-- [ ] first\n+- [x] first\n*** Add File: notes/new.md\n+# New note\n+\n+Written during QA.\n*** End Patch"
      }
    },
    {
      "tool": "exec_command",
      "arguments": {
        "workspace_id": "{{workspace_id}}",
        "cmd": "git status --short"
      },
      "expect": {
        "text": [
          "notes/todo.md",
          "notes/new.md"
        ]
      }
    },
    {
      "tool": "show_changes",
      "arguments": {
        "workspace_id": "{{workspace_id}}"
      }
    }
  ]
}
