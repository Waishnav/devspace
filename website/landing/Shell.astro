---
// Minimal document shell for the landing page. The docs keep Blume's own
// chrome; landing pages need full control over typography and layout.
interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const SITE = "https://devspace.run";

const {
  title = "DevSpace — let your agents delegate to each other",
  description = "Connect Grok Bot, ChatGPT, and Claude to your machine, and let any agent delegate to Codex, Claude Code, OpenCode, Cursor, and more.",
  bodyClass,
} = Astro.props;

const url = new URL(Astro.url.pathname, SITE).href;

// Blume generates the home route's card; scripts/og-cards.mjs redraws it after the build.
const image = `${SITE}/og/index.png`;

// Docs pages get Blume's WebSite and SoftwareApplication graph; the landing page
// uses its own shell, so it declares the same identity here.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${SITE}/#website`, name: "DevSpace", url: `${SITE}/`, description },
    {
      "@type": "SoftwareApplication",
      name: "DevSpace",
      url: `${SITE}/`,
      description,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux, Windows",
      license: "https://opensource.org/licenses/MIT",
      offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
      sameAs: ["https://github.com/Waishnav/devspace", "https://www.npmjs.com/package/@waishnav/devspace"],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#f5f5f3" />
    <link rel="icon" type="image/png" href="/logos/devspace-tile.png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DevSpace" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@wshxnv" />
    <meta name="twitter:creator" content="@wshxnv" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>

<script>
  // Any element with data-copy copies its value and flags data-copied briefly.
  document.addEventListener("click", async (event) => {
    // SAFETY: The surrounding checks or construction already match this type.
    const target = (event.target as HTMLElement).closest<HTMLElement>("[data-copy]");

    if (!target) return;

    // Only claim success when the clipboard write actually happened.
    if (!navigator.clipboard) return;

    try {
      await navigator.clipboard.writeText(target.dataset.copy ?? "");
    } catch {
      return;
    }

    target.dataset.copied = "";
    setTimeout(() => delete target.dataset.copied, 1400);
  });
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; -webkit-font-smoothing: antialiased; }
  img, svg { display: block; max-width: 100%; }
  a { color: inherit; }
  button { font: inherit; color: inherit; }
</style>
