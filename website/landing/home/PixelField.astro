---
// A dithered, pixel-mosaic landscape rendered as crisp SVG at build time.
// Deterministic so every build produces the same picture.
interface Props { cols?: number; rows?: number }

const { cols = 64, rows = 30 } = Astro.props;

let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

type RGB = [number, number, number];

const stops: Array<[number, RGB]> = [
  [0.0, [86, 128, 196]],
  [0.3, [128, 162, 214]],
  [0.46, [214, 196, 186]],
  [0.56, [226, 150, 104]],
  [0.63, [120, 108, 120]],
  [0.7, [120, 146, 86]],
  [1.0, [70, 104, 58]],
];

// SAFETY: The surrounding checks or construction already match this type.
const mix = (a: RGB, b: RGB, t: number): RGB => [0, 1, 2].map((i) => a[i]! + (b[i]! - a[i]!) * t) as RGB;

const colorAt = (y: number): RGB => {
  for (let i = 1; i < stops.length; i++) {
    const [p1, c1] = stops[i]!;
    const [p0, c0] = stops[i - 1]!;

    if (y <= p1) return mix(c0, c1, (y - p0) / (p1 - p0));
  }

  return stops.at(-1)![1];
};

// Stepped notches in the corners, like missing tiles.
const notched = (x: number, y: number) =>
  (y < 3 && x < 5) || (y < 1 && x < 8) || (y < 5 && x > cols - 5) || (y < 2 && x > cols - 9) ||
  (y > rows - 4 && x < 3) || (y > rows - 2 && x < 6);

const cells: Array<{ x: number; y: number; fill: string }> = [];

for (let y = 0; y < rows; y++) {
  for (let x = 0; x < cols; x++) {
    if (notched(x, y)) continue;
    // Cloud bank and a soft horizon wobble keep it from reading as a gradient.
    const wobble = Math.sin(x * 0.35) * 0.025 + Math.sin(x * 0.11 + 1.3) * 0.03;
    const cloud = y / rows > 0.32 && y / rows < 0.5 && Math.sin(x * 0.22 + y * 0.9) > 0.35 ? 0.22 : 0;
    const t = Math.min(1, Math.max(0, y / rows + wobble + (rand() - 0.5) * 0.07));
    const [r, g, b] = mix(colorAt(t), [240, 234, 226], cloud);
    const j = (rand() - 0.5) * 14;
    cells.push({ x, y, fill: `rgb(${Math.round(r + j)},${Math.round(g + j)},${Math.round(b + j)})` });
  }
}
---

<svg class="pixel-field" viewBox={`0 0 ${cols} ${rows}`} preserveAspectRatio="none" shape-rendering="crispEdges" aria-hidden="true">
  {cells.map((c) => <rect x={c.x} y={c.y} width="1.02" height="1.02" fill={c.fill} />)}
</svg>

<style>
  .pixel-field { width: 100%; height: 100%; }
</style>
