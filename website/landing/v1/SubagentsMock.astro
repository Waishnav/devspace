---
import Logo from "../../logos/Logo.astro";
// Illustrative: a coding agent delegating reviews to two other agents. Commands
// and XML fragments mirror the real `devspace agents` output; ids are made up.
---

<div class="mock" role="img" aria-label="Illustration: Claude Code delegating reviews to Codex and Pi with devspace agents, then waiting for both results">
  <div class="mock__bar">
    <span class="mock__dots"><i></i><i></i><i></i></span>
    <span class="mock__title"><Logo id="claude" size={14} /> Claude Code · <b>~/work/billing</b></span>
    <span class="mock__pill">devspace skill</span>
  </div>

  <div class="mock__body sh">
    <p class="r" style="--d:.2s"><span class="dim">›</span> get Codex and Pi to review this before I merge</p>
    <p class="r" style="--d:.9s"><span class="prompt">$</span> devspace agents targets</p>
    <p class="r xml" style="--d:1.2s">&lt;provider name="codex" model="gpt-6-astra" effort="xhigh"/&gt;</p>
    <p class="r xml" style="--d:1.35s">&lt;provider name="pi" model="fable-5.1" effort="high"/&gt;</p>
    <p class="r" style="--d:2s"><span class="prompt">$</span> devspace agents run codex "Review the staged diff for correctness…"</p>
    <p class="r xml" style="--d:2.4s">&lt;agent id="agt_7Kq2" status="running"/&gt;</p>
    <p class="r" style="--d:3s"><span class="prompt">$</span> devspace agents run pi "Check the staged diff for test gaps…"</p>
    <p class="r xml" style="--d:3.4s">&lt;agent id="agt_Q9m4" status="running"/&gt;</p>
    <p class="r" style="--d:4s"><span class="prompt">$</span> devspace agents wait agt_7Kq2 agt_Q9m4</p>
    <p class="r xml" style="--d:5.2s">&lt;agent id="agt_7Kq2" status="completed"&gt;<span class="fg">1 finding: export.ts:48 unescaped quote</span>&lt;/agent&gt;</p>
    <p class="r xml" style="--d:5.7s">&lt;agent id="agt_Q9m4" status="completed"&gt;<span class="fg">missing test: empty invoice list</span>&lt;/agent&gt;</p>
    <p class="r" style="--d:6.4s"><span class="dim">›</span> Both reviews are in. Fixing export.ts:48 and adding the empty-list test.<i class="caret"></i></p>

    <div class="agents">
      <div class="agent r" style="--d:2.4s"><Logo id="openai" size={14} /><b>codex</b><span class="st">reviewing</span></div>
      <div class="agent r" style="--d:3.4s"><Logo id="pi" size={14} /><b>pi</b><span class="st">reviewing</span></div>
    </div>
  </div>
</div>

<style>
  .sh { padding: 18px 20px; position: relative; }
  .sh p { margin: 0; word-break: break-word; }
  .prompt { color: #c9f26a; }
  .fg { color: #ececf0; }
  .caret { display: inline-block; width: 7px; height: 14px; background: #c9f26a; vertical-align: -2px; margin-left: 3px; animation: mock-blink 0.8s infinite alternate; }
  .agents { position: absolute; right: 20px; top: 18px; display: grid; gap: 6px; }
  .agent { display: flex; align-items: center; gap: 8px; border: 1px solid var(--m-line); background: var(--m-panel); border-radius: 6px; padding: 5px 10px; }
  .agent b { font-weight: 500; }
  .st { color: #f0a54a; font-size: 11px; }
  .st::before { content: "● "; animation: mock-blink 0.9s infinite alternate; }
  @media (max-width: 820px) { .agents { display: none; } }
</style>
