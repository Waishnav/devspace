---
import "./mock.css";
import Logo from "../../logos/Logo.astro";
import ChatMock from "./ChatMock.astro";
import SubagentsMock from "./SubagentsMock.astro";
import RoutingMap from "./RoutingMap.astro";

const tabs = [
  { label: "In your chat app", logo: "openai" as const },
  { label: "Delegating", logo: "claude" as const },
  { label: "Any host, any agent", logo: null },
];
---

<div class="hero-stage" data-tabs>
  <div class="tabs" role="tablist">
    {tabs.map((tab, i) => (
      <button role="tab" aria-selected={i === 0 ? "true" : "false"} data-tab={i}>
        {tab.logo && <Logo id={tab.logo} size={14} />}{tab.label}
      </button>
    ))}
  </div>
  <div class="panels">
    <div class="panel is-active" data-panel="0"><ChatMock /></div>
    <div class="panel" data-panel="1"><SubagentsMock /></div>
    <div class="panel" data-panel="2"><RoutingMap /></div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-tabs]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const show = (i: number) => {
      current = i;
      tabs.forEach((t, j) => t.setAttribute("aria-selected", String(i === j)));
      panels.forEach((p, j) => p.classList.toggle("is-active", i === j));
    };
    // Autoplay until the visitor picks a tab themselves.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      timer = setInterval(() => show((current + 1) % panels.length), 14000);
    }
    tabs.forEach((t, i) => t.addEventListener("click", () => { clearInterval(timer); show(i); }));
    const initial = Number(new URLSearchParams(location.search).get("tab"));
    if (initial > 0 && initial < panels.length) show(initial);
  }
</script>

<style>
  .tabs { display: flex; justify-content: center; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }
  .tabs button {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer; padding: 8px 14px;
    background: rgba(250, 250, 248, 0.88); border: 1px solid rgba(21, 21, 21, 0.18); color: #3e3d3a;
    font: 500 12.5px "IBM Plex Mono", monospace; backdrop-filter: blur(6px);
  }
  .tabs button:hover { border-color: #151515; }
  .tabs button[aria-selected="true"] { background: #151515; border-color: #151515; color: #f5f5f3; }
  /* Every tab shares one height so the window stays centred in the frame. */
  .panels { position: relative; height: 680px; }
  .panel { display: none; height: 100%; }
  .panel.is-active { display: block; }
  .panel > :global(.mock) { height: 100%; }

  @media (max-width: 820px) { .panels { height: auto; } .panel > :global(.mock) { height: auto; } }
</style>
