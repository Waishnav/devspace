{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devspace-agent-changes-v0",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "ai": {"binding": "AI", "remote": true},
  "worker_loaders": [{"binding": "LOADER"}],
  "containers": [{
    "class_name": "TaskAgent",
    "scheduling_policy": "durable_object",
    "images": { "app": { "dockerfile": "./Dockerfile" } }
  }],
  "artifacts": [{"binding": "ARTIFACTS", "namespace": "devspace-agent-changes", "remote": true}],
  "durable_objects": {
    "bindings": [{"name": "PROJECTS", "class_name": "ProjectCoordinator"}, {"name": "RUNS", "class_name": "TaskAgent"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ProjectCoordinator"]}, {"tag": "v2", "new_sqlite_classes": ["TaskAgent"]}]
}
