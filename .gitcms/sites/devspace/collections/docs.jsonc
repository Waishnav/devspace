{
  "label": "Docs",
  "git_path": "/website/docs/",
  "file_extension": ".mdx",
  "filename_pattern": "",
  "collection_type": "grouped",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title",
      "required": false
    },
    {
      "name": "description",
      "type": "richtext",
      "label": "Description",
      "required": false
    },
    {
      "name": "sidebar",
      "type": "object",
      "label": "Sidebar",
      "required": false,
      "fields": [
        {
          "name": "icon",
          "type": "text",
          "label": "Icon",
          "required": false
        }
      ]
    }
  ]
}
